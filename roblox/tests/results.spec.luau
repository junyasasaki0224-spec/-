local rules = require("../src/ResultRules")
local first = rules.apply(nil,{won=true,time=102.5},"race-1",16)
assert(first.races==1 and first.wins==1 and first.rating==1516 and first.bestTime==102.5)
local duplicate = rules.apply(first,{won=true,time=102.5},"race-1",16)
assert(duplicate.races==1 and duplicate.wins==1 and duplicate.rating==1516 and duplicate.version==1)
local flying = rules.apply(duplicate,{won=false},"race-2",-16)
assert(flying.races==2 and flying.wins==1 and flying.rating==1500 and flying.bestTime==102.5)
local slower = rules.apply(flying,{won=false,time=110},"race-3",0)
assert(slower.bestTime==102.5)
local faster = rules.apply(slower,{won=false,time=99},"race-4",0)
assert(faster.bestTime==99 and faster.races==4)
assert(first.races==1 and #first.recentRaces==1,"inputs are not mutated")
local existing = {rating=1500,races=2,wins=1,version=2,otherField="preserved"}
local migrated = rules.apply(existing,{won=false},"race-5",0)
assert(migrated.otherField=="preserved" and migrated.races==3,"unrelated stored data must survive updates")
print("result checks passed")
